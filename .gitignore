# Local generated output. The renderer subproject keeps its own ignore list;
# these patterns keep workspace output and stray files out of the wrapper repo.
/out/
*.dmp
*.log
/benchmarks/out/
/benchmarks/baselines/*.exe
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
/benchmarks/.venv/

# Temporary files, crash output, and local editor/OS metadata.
*.tmp
*.temp
*.bak
*.swp
*~
*.stackdump
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db
Desktop.ini
